<Window x:Class="UITestAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI Test Automation" Height="660" Width="1000" MinHeight="600" MinWidth="860"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="UI Test Automation" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="Record clicks and keys on one window, then play them back."/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" Background="#EEF2FF"
                        CornerRadius="12" Padding="12,5">
                    <TextBlock x:Name="TxtTarget" Foreground="#3730A3" FontSize="12" Text="Target: none"/>
                </Border>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Idle" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Hint}" Text="Stop playback" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#F3F4F6" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="4" Padding="6,1">
                        <TextBlock Text="Ctrl + Alt + X" FontFamily="Consolas" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="MACRO"/>
                            <UniformGrid Columns="2" Margin="0,0,-8,0">
                                <Button x:Name="BtnRecord" Style="{StaticResource DangerButton}" Click="BtnRecord_Click"
                                        AutomationProperties.Name="Record">● Record</Button>
                                <Button x:Name="BtnStopRecord" Click="BtnStopRecord_Click" IsEnabled="False">Stop Record</Button>
                                <Button x:Name="BtnPlay" Style="{StaticResource PrimaryButton}" Click="BtnPlay_Click" IsEnabled="False"
                                        AutomationProperties.Name="Play">▶ Play</Button>
                                <Button x:Name="BtnStopPlay" Click="BtnStopPlay_Click" IsEnabled="False">Stop</Button>
                                <Button x:Name="BtnLoad" Click="BtnLoad_Click">Load JSON</Button>
                                <Button x:Name="BtnSave" Click="BtnSave_Click" IsEnabled="False">Save JSON</Button>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Press ESC to stop recording. Clicks on this window are not recorded."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ANDROID PLAYBACK (ADB)"/>
                            <CheckBox x:Name="ChkUseAdb" Content="Use ADB for playback"
                                      Checked="ChkUseAdb_Checked" Unchecked="ChkUseAdb_Unchecked"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Device" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBox x:Name="TxtDevW" Grid.Column="1" Text="1080" IsEnabled="False"/>
                                <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Margin="8,0"
                                           Foreground="{StaticResource Muted}"/>
                                <TextBox x:Name="TxtDevH" Grid.Column="3" Text="2400" IsEnabled="False"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Line}" Margin="0,14"/>

                            <TextBlock FontWeight="SemiBold" Text="Calibration" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,-8,0">
                                <Button x:Name="BtnCalibStart" Click="BtnCalibStart_Click">Start</Button>
                                <Button x:Name="BtnCalibClear" Click="BtnCalibClear_Click">Clear</Button>
                            </UniformGrid>

                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Offset X"/>
                                    <TextBlock x:Name="LblOffX" Text="-" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Offset Y"/>
                                    <TextBlock x:Name="LblOffY" Text="-" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Width"/>
                                    <TextBlock x:Name="LblCW" Text="-" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Text="Height"/>
                                    <TextBlock x:Name="LblCH" Text="-" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="LblCalibHint" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Click Start, then click the top-left and bottom-right corners of the phone screen."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="RECORDED EVENTS" Margin="0"/>
                            <TextBlock x:Name="TxtCount" Grid.Column="1" Style="{StaticResource Hint}" Margin="8,0,0,0"
                                       FontSize="11" VerticalAlignment="Center" Text="0"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="Double-click to remove"/>
                        </Grid>
                        <ListBox x:Name="ListEvents" BorderThickness="0" Margin="8,0,8,8"
                                 MouseDoubleClick="ListEvents_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding No}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border x:Name="Badge" Grid.Column="1" HorizontalAlignment="Left" CornerRadius="4"
                                                Padding="6,1" Background="#DBEAFE">
                                            <TextBlock x:Name="BadgeText" Text="{Binding Kind}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#1E40AF"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontFamily="Consolas"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Delay}" Foreground="{StaticResource Muted}"
                                                   FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="KEY DOWN">
                                            <Setter TargetName="Badge" Property="Background" Value="#D1FAE5"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#065F46"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="KEY UP">
                                            <Setter TargetName="Badge" Property="Background" Value="#F3F4F6"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="#4B5563"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="MACRO JSON" Margin="0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="Editable, applied when you press Play"/>
                        </Grid>
                        <TextBox x:Name="TxtJson" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 VerticalContentAlignment="Top" Background="Transparent" BorderThickness="0,1,0,0"
                                 BorderBrush="{StaticResource Line}" Padding="12,8"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
